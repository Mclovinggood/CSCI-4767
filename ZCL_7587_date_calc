CLASS zcl_7587_date_calc DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC .

  PUBLIC SECTION.
    INTERFACES if_oo_adt_classrun.

  PROTECTED SECTION.
  PRIVATE SECTION.
ENDCLASS.

CLASS zcl_7587_date_calc IMPLEMENTATION.

  METHOD if_oo_adt_classrun~main.

    " 1. Current system date (type D)
    DATA(today) = cl_abap_context_info=>get_system_date( ).
    out->write( |Today (type D): { today }| ).

    " 2. Simple date arithmetic (add days)
    DATA(future_date) = today + 10.
    out->write( |10 days later: { future_date }| ).

    " 3. Current UTC timestamp (utclong)
    DATA(now) = utclong_current( ).
    out->write( |Current UTC timestamp: { now }| ).

    " 4. Add days to timestamp
    DATA(future_ts) = utclong_add( val = now days = 7 ).
    out->write( |+7 days (utclong): { future_ts }| ).

    " 5. Calculate difference in seconds
    DATA(diff_seconds) = utclong_diff( high = future_ts low = now ).
    out->write( |Difference in seconds: { diff_seconds }| ).

    " 6. Convert UTC timestamp to user local time
    DATA(user_date) TYPE d.
    DATA(user_time) TYPE t.
    CONVERT UTCLONG now
      INTO DATE user_date
           TIME user_time
           TIME ZONE cl_abap_context_info=>get_user_time_zone( ).

    out->write( |Your local date: { user_date date = user }| ).
    out->write( |Your local time: { user_time time = user }| ).

  ENDMETHOD.

ENDCLASS.
