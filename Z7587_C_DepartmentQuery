@EndUserText.label: 'Department Query with Aggregations'
define view entity Z7587_C_DepartmentQuery
  with parameters
    p_target_curr : /dmo/currency_code,
    @EndUserText.label: 'Date of evaluation'
    @Environment.systemField: #SYSTEM_DATE
    p_date        : abap.dats

as select from Z7587_C_EmployeeQueryP( p_target_curr: $parameters.p_target_curr,
                                     p_date: $parameters.p_date ) as e

  right outer join Z7587_R_Department as d
    on e.DepartmentId = d.Id

{
  key d.Id                           as DepartmentId,
  key d.Description                  as DepartmentDescription,

      avg( e.CompanyAffiliation as abap.dec(11,1) ) as AverageAffiliation,

      @Semantics.amount.currencyCode: 'CurrencyCode'
      sum( e.AnnualSalaryConverted ) as TotalSalary,

      e.CurrencyCode
}
group by
  d.Id,
  d.Description,
  e.CurrencyCode
